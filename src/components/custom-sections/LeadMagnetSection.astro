---
import { COLORS } from '../../lib/colors';
---
<div class="h-full">  <div
    class="bg-blue-500 text-white text-center py-6 px-6"
    style=`background-color: ${COLORS.secondaryDark}`
  >
    <h1 class="text-5xl font-barlow mt-3 text-white" style="letter-spacing: 0.1em;">THANK YOU FOR YOUR PURCHASE!</h1>
  </div>
  
  <div class="max-w-5xl mx-auto px-6 py-10 flex flex-col md:flex-row items-center">
     <div class="hidden md:flex mt-10 md:mt-0 md:w-1/2 flex justify-center">
      <img
        src="/canning-cover.png"
        alt="Canning Meat Cookbook Book Cover"
        class="w-80 md:w-96 shadow-2xl rounded-lg transform hover:scale-105 transition-all opacity-100"
      />
    </div>

    <!-- RIGHT: CONTENT -->
    <div class="mt-0 md:mt-10 md:mt-0 md:w-1/2 flex flex-col md:mx-6">
      <h2 class="text-5xl font-barlow mt-3 text-white" style=`letter-spacing: 0.1em; color: ${COLORS.secondaryDark}`>UNLOCK YOUR FREE COMPLEMENTARY GUIDE</h2>
      <h3 class="font-bold mb-4 text-2xl">The Ultimate Canning Success Toolkit</h3>

      <ul class="mb-8">
        <li>✅ MASTER SAFE TIMES (Altitude & Pressure Charts)</li>
        <li>✅ FAST 15-MINUTE RECIPES (Using Your Meat Pantry)</li>
        <li>✅ SAFETY CHECKLISTS (Never Stress Again)</li>
      </ul>
      <button id="openModal" class="btn">CLAIM YOUR GUIDE NOW</button>

<div id="modal" class="fixed inset-0 hidden items-center justify-center bg-black bg-opacity-40 backdrop-blur-sm z-50">
  <div class="m-2 bg-white p-6 rounded-2xl shadow-2xl max-w-md w-full">
    <div class="flex justify-end">

      <button
      id="closeModal"
      class="top-3 right-3 text-gray-500 hover:text-black">
       <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>
    
    </div>
   
          <h2 class="text-xl mb-4 font-barlow">Get your free guide</h2>

          <!-- <input
            type="email"
            class="border w-full p-4 mb-4"
            placeholder="Email"
          />

          <button class="btn w-full mb-2">Submit</button> -->
          <div class="_form_1"></div><script src="https://gahema.activehosted.com/f/embed.php?id=1" charset="utf-8"></script>
        </div>
      </div>
      <p class="text-center" style="font-size: 12px; margin-top: 10px;">
        We respect your privacy. No spam, ever.
      </p>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('modal')
  const openBtn = document.getElementById('openModal')
  const closeBtn = document.getElementById('closeModal')

  openBtn.addEventListener('click', () => {
    modal.classList.remove('hidden')
    modal.classList.add('flex')
  })

  closeBtn.addEventListener('click', () => {
    modal.classList.add('hidden')
    modal.classList.remove('flex')
  })
 
function setOriginField() {
    const form = document.querySelector("form._form_1");
    if (!form) return false;

    let originInput = form.querySelector('input[name="field[2]"]');

    if (!originInput) {
      console.log("Origin field[2] not found, creating it.");

      originInput = document.createElement("input");
      originInput.type = "hidden";
      originInput.name = "field[2]";
      form.appendChild(originInput);
    }

    originInput.value = "qr1";

    console.log("Origin field[2] value:", originInput.value);

    return true;
  }

  document.addEventListener("DOMContentLoaded", function () {
    const interval = setInterval(() => {
      if (setOriginField()) {
        clearInterval(interval);
      }
    }, 300);
  });

  document.addEventListener(
    "submit",
    function (event) {
      if (event.target.matches("form._form_1")) {
        setOriginField();
      }
    },
    true
  );
</script>

  <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f5f5f0;
        color: #2e3b1f;
      }

      .container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 40px 20px;
      }

      h1 {
        text-align: center;
        font-size: 28px;
        margin-bottom: 10px;
      }

      h2 {
        text-align: center;
        font-size: 36px;
        margin-bottom: 40px;
      }

      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: center;
      }

      .book img {
        width: 100%;
        border-radius: 10px;
      }

      .features h3 {
        color: #c85d1a;
        margin-bottom: 20px;
      }

      .features ul {
        list-style: none;
        padding: 0;
      }

      .features li {
        margin-bottom: 15px;
        font-size: 16px;
      }

      .form {
        margin-top: 30px;
      }

      .form input {
        width: 100%;
        padding: 12px;
        margin-bottom: 10px;
        border-radius: 8px;
        border: 1px solid #ccc;
        font-size: 14px;
      }

      .btn {
        width: 100%;
        padding: 14px;
        background: #d86b2c;
        color: white;
        border: none;
        border-radius: 25px;
        font-size: 16px;
        cursor: pointer;
      }

      .btn:hover {
        background: #b9561f;
      }

      .footer {
        margin-top: 40px;
        text-align: center;
        font-weight: bold;
      }

      @media (max-width: 768px) {
        .grid {
          grid-template-columns: 1fr;
        }

        h2 {
          font-size: 28px;
        }
      }
    </style>