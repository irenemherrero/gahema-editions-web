---
import "./styles.css";
const { leadMagnetId } = Astro.props;
import {amishCover} from '../../../../lib/constants';

const bonuses = {
  qr1: {
    title: "Pressure Canning Starter Checklist Pack",
    description:
      "Once confirmed, you’ll receive two printable checklists to help you prepare, process, and seal your first batch safely.",
  },
  qr2: {
    title: "Fresh at Serving Guide",
    description:
      "Once confirmed, you’ll receive four authentic Amish finishing recipes that transform your jars into complete family meals in under 20 minutes.",
  },
};

const bonusKey = leadMagnetId
const bonus = bonuses[bonusKey];
---

<main class="confirmation-page">
  <header class="confirmation-topbar">
    <p>Almost there!</p>
    <h1>Check your inbox</h1>
  </header>

  <section class="confirmation-section">
    <div class="confirmation-inner">
      <div class="confirmation-image">
        <img
          src={amishCover}
          alt="Canning Meat Cookbook for Beginners"
        />
      </div>

      <div class="confirmation-content">
        <p class="eyebrow">One quick step left</p>

        <h2>
          Your access to the <span>“{bonus.title}”</span> is pending
          confirmation.
        </h2>

        <p class="confirmation-description">
          {bonus.description}
        </p>

        <div class="confirmation-steps">
          <div class="confirmation-step">
            <span>1</span>
            <div>
              <h3>Find our email</h3>
              <p>From: GAHEMA PRESS TEAM</p>
            </div>
          </div>

          <div class="confirmation-step">
            <span>2</span>
            <div>
              <h3>Check Promotions or Spam</h3>
              <p>If you don’t see it in your inbox, look there next.</p>
            </div>
          </div>

          <div class="confirmation-step">
            <span>3</span>
            <div>
              <h3>Click the confirmation link</h3>
              <p>Your free bonus will be sent after confirmation.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>