---
import "../styles.css"
import { amishCover } from "../../../../../lib/constants"
---

  <main>
    <section class="book-landing">

      <!-- HERO -->
      <section class="hero book-hero">
        <div class="hero__inner">
          <div class="hero__image">
            <img
              src={amishCover}
              alt="The Ultimate Amish Canning Meat Cookbook for Beginners"
            />
          </div>

          <div class="hero__content">
            <p class="eyebrow">Free bonus for readers</p>

            <h1>The Jar Holds Everything. You Bring the Rest.</h1>

            <p class="subtitle">
              Download your free <strong>Fresh at Serving Guide</strong> —
              four authentic Amish finishing recipes that transform your jars
              into complete family meals in under 20 minutes.
            </p>

            <ul class="benefits">
              <li>Traditional Amish dumplings</li>
              <li>Homemade egg noodles</li>
              <li>Classic Amish pot pie crust</li>
            </ul>

            <button class="openModal button">
          Download Fresh at Serving Guide
        </button>

            <p class="privacy">
              Printable PDF • Free for readers
            </p>
          </div>
        </div>
      </section>

      <!-- STRIP -->

      <section class="trust">
        <h2>The canned meal is complete. The fresh element makes it unforgettable.</h2>

        <p>
          Discover the finishing touches Amish families have added to these dishes for generations.
        </p>
      </section>

      <!-- CONTENTS -->

      <section class="section">

        <h2>Inside This Guide</h2>

        <div class="pack-card">

          <div class="pack-item">
            <span>①</span>
            <div>
              <h3>Boova Shenkel Dumplings</h3>
              <p>Soft, pillowy dumplings for Beef and Dumpling Stew.</p>
            </div>
          </div>

          <div class="pack-item">
            <span>②</span>
            <div>
              <h3>Schnitz un Knepp Dumplings</h3>
              <p>Traditional dumplings for Pork and Dried Apple Stew.</p>
            </div>
          </div>

          <div class="pack-item">
            <span>③</span>
            <div>
              <h3>Homemade Egg Noodles</h3>
              <p>Ready in about 20 minutes for any broth recipe in the book.</p>
            </div>
          </div>

          <div class="pack-item">
            <span>④</span>
            <div>
              <h3>Amish Pot Pie Crust</h3>
              <p>A rustic biscuit-style topping for Chicken Pot Pie Filling.</p>
            </div>
          </div>

        </div>

      </section>

      <!-- WHY -->

      <section class="problem-section">

        <div class="problem-card">

          <h2 style="padding-bottom:18px;">Simple Recipes. Big Difference.</h2>

          <p>
            None of these recipes belong inside the canning jar.
            That's exactly what makes them special.
          </p>

          <ul class="simple-list">
            <li>The jar provides the slow-cooked meat and rich broth.</li>
            <li>The fresh recipe is prepared while everything heats.</li>
            <li>Together they create the complete Amish meal.</li>
          </ul>

          <p>
            Most take less than 20 minutes from start to table.
          </p>

        </div>

      </section>

      <!-- HOW -->

      <section class="section">

        <h2>How It Works</h2>

        <div class="steps book-categories">

          <div>
            <span>1</span>
            <h3>Open</h3>
            <p>Open your jar and begin heating the contents.</p>
          </div>

          <div>
            <span>2</span>
            <h3>Prepare</h3>
            <p>Mix the fresh dumplings, noodles, or crust while the jar heats.</p>
          </div>

          <div>
            <span>3</span>
            <h3>Serve</h3>
            <p>Bring everything together at the table—the Amish way.</p>
          </div>

        </div>

      </section>

      <!-- CTA -->

      <section class="final-cta">

        <h2>Complete the Recipes the Amish Way</h2>

        <p>
          Download your free Fresh at Serving Guide and discover the homemade
          finishing recipes designed specifically for the dishes in the book.
        </p>

        <button class="openModal button" style="margin-top: 12px;">
          Download Fresh at Serving Guide
        </button>

        <p class="privacy">
          Free printable companion guide for readers of
          <em>The Ultimate Amish Canning Meat Cookbook for Beginners.</em>
        </p>

      </section>

    </section>
  </main>

<div
  id="modal"
  class="fixed inset-0 hidden items-center justify-center bg-black bg-opacity-40 backdrop-blur-sm z-50"
>
  <div class="m-2 bg-white p-6 rounded-2xl shadow-2xl max-w-md w-full">
    <div class="flex justify-between items-start">
      <h2 style="padding-top: 40px">Get Your Free Sauce Guide</h2>
      <button
          id="closeModal"
          class="text-gray-500 hover:text-black"
        >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    </div>
   <div class="_form_9"></div><script src="https://gahema.activehosted.com/f/embed.php?id=9" charset="utf-8"></script>
  </div>
</div>

<script>
  const modal = document.getElementById("modal");
  const openBtns = document.querySelectorAll(".openModal");
  const closeBtn = document.getElementById("closeModal");

  function openModal() {
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }

  function closeModal() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
  }

  openBtns.forEach((btn) => {
    btn.addEventListener("click", openModal);
  });

  closeBtn.addEventListener("click", closeModal);

  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });
</script>