---
import "./styles.css";
---

<main class="landing">
  <!-- HERO -->
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__image">
        <img
          src="/canning-cover.png"
          alt="Canning Meat Cookbook for Beginners"
        />
      </div>

      <div class="hero__content">
        <p class="eyebrow">Free bonus for readers</p>

        <h1>Start Your First Meat Canning Session with Confidence</h1>

        <p class="subtitle">
          Get your <strong>Printable Checklist Pack</strong> and follow every
          step safely — from prep to seal check.
        </p>

        <ul class="benefits">
          <li>Never forget a critical step</li>
          <li>Avoid beginner mistakes</li>
          <li>Stay safe and consistent</li>
        </ul>

        <button class="openModal button">
          Download Your Checklist Pack
        </button>

        <p class="privacy">
          No spam. Just practical tools you’ll actually use.
        </p>

        <!-- MODAL -->
        <div
          id="modal"
          class="fixed inset-0 hidden items-center justify-center bg-black bg-opacity-40 backdrop-blur-sm z-50"
        >
          <div class="m-2 bg-white p-6 rounded-2xl shadow-2xl max-w-md w-full">
            <div class="flex justify-between items-start">
              <h2 style="padding-top: 40px">Get your free guide</h2>

              <button
                id="closeModal"
                class="text-gray-500 hover:text-black"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"
                  />
                </svg>
              </button>
            </div>

            <div class="_form_1"></div>
            <script
              src="https://gahema.activehosted.com/f/embed.php?id=1"
              charset="utf-8"
            ></script>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section class="trust">
    <h2>New to pressure canning? You’re not alone.</h2>
    <p>
      Most beginners feel unsure before their first batch — this is exactly why
      this checklist pack exists.
    </p>
  </section>

  <!-- WHAT'S INSIDE -->
  <section class="section">
    <h2>What’s Inside Your Checklist Pack</h2>

    <div class="pack-card">
      <div class="pack-item">
        <span>✓</span>
        <div>
          <h3>Checklist 1 — Equipment & Pre-Session Setup</h3>
          <p>
            Everything you need before your first session — and what to
            double-check every time.
          </p>
        </div>
      </div>

      <div class="pack-item">
        <span>✓</span>
        <div>
          <h3>Checklist 2 — Step-by-Step Canning Process</h3>
          <p>
            From the night before to the 24-hour seal check — every step in
            order.
          </p>
        </div>
      </div>
    </div>

    <p class="note">
      Both checklists are printable — keep them next to you while you work.
    </p>
  </section>

  <!-- PROBLEM SOLUTION -->
  <section class="problem-section">
    <div class="problem-card">
      <h2>Why Most First Batches Go Wrong</h2>

      <p>
        Most beginners don’t fail because they lack information. They fail because
        they miss small steps at the wrong moment.
      </p>

      <ul class="simple-list">
        <li>They forget small steps.</li>
        <li>They rush the process.</li>
        <li>They lose track of pressure or timing.</li>
      </ul>

      <p>
        This checklist keeps everything in one place — so you can focus, stay
        organized, and do it right.
      </p>
    </div>
  </section>

  <!-- HOW TO USE -->
  <section class="section">
    <h2>How You’ll Use It</h2>

    <div class="steps">
      <div>
        <span>1</span>
        <h3>Print</h3>
        <p>Print the checklist before your session.</p>
      </div>

      <div>
        <span>2</span>
        <h3>Keep It Nearby</h3>
        <p>Place it next to you in the kitchen.</p>
      </div>

      <div>
        <span>3</span>
        <h3>Follow Each Step</h3>
        <p>Check off each step as you go.</p>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta" id="signup">
    <h2>Start Your First Batch the Right Way</h2>

    <p>
      Download your checklist pack and follow every step with confidence.
    </p>

    <button class="openModal button" style="margin-top: 12px;">
      Download Your Checklist Pack
    </button>

    <p class="privacy">
      No spam. Just practical tools you’ll actually use.
    </p>
  </section>
</main>

<script>
  const modal = document.getElementById('modal');
  const openBtns = document.querySelectorAll('.openModal');
  const closeBtn = document.getElementById('closeModal');

  openBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    });
  });

  closeBtn.addEventListener('click', () => {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  });
</script>