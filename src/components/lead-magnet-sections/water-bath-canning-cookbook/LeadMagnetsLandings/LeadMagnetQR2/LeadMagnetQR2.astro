---
import "../styles.css";
import {waterBathCover} from '../../../../../lib/constants';

---

  <main>
    <section class="book-landing">

      <!-- HERO -->
      <section class="hero book-hero">
        <div class="hero__inner">

          <div class="hero__image">
            <img
              src={waterBathCover}
              alt="The Ultimate Water Bath Canning Cookbook for Beginners"
            />
          </div>

          <div class="hero__content">

            <p class="eyebrow">Free bonus for readers</p>

            <h1>Know What's Normal. Know What's Risky. Know What to Do Next.</h1>

            <p class="subtitle">
              Download your printable Water Bath Canning Troubleshooting Guide —
              a quick reference to help you recognize normal signs, identify real
              problems, and make safe decisions before and after storing your jars.
            </p>

            <ul class="benefits">
              <li>Normal vs. unsafe signs at a glance</li>
              <li>Simple actions for common canning problems</li>
              <li>Designed to keep beside your canning station</li>
            </ul>

            <button class="openModal button">
          Download the Free Troubleshooting Guide
        </button>

            <p class="privacy">
              Printable PDF • Free for readers
            </p>

          </div>
        </div>
      </section>

      <!-- TRUST -->

      <section class="trust">

        <h2>Built for the moments that make you hesitate.</h2>

        <p>
          Every experienced home canner has looked at a jar and wondered,
          "Is this normal?" This guide helps you answer that question with
          confidence.
        </p>

      </section>



      <!-- WHAT'S INSIDE -->

      <section class="section">

        <h2>What's Inside</h2>

        <div class="pack-card">

          <div class="pack-item">
            <span>✓</span>

            <div>

              <h3>After Processing</h3>

              <p>
                Safety checklists, normal signs, and troubleshooting while jars
                cool and seal.
              </p>

            </div>

          </div>

          <div class="pack-item">
            <span>✓</span>

            <div>

              <h3>Before Serving</h3>

              <p>
                What to check before opening every jar and how to recognize
                spoilage before it's too late.
              </p>

            </div>

          </div>

          <div class="pack-item">
            <span>✓</span>

            <div>

              <h3>Safe Disposal Protocol</h3>

              <p>
                A simple step-by-step procedure for handling suspect jars safely,
                without guessing.
              </p>

            </div>

          </div>

        </div>

      </section>

      <!-- PROBLEM -->

      <section class="problem-section">

        <div class="problem-card">

          <h2 style="padding-bottom:18px">
            Because not every unusual jar is an unsafe jar.
          </h2>

          <p>

            Water bath canning naturally changes the appearance of food.
            Knowing which changes are harmless—and which require action—is
            one of the most valuable skills a home canner can learn.

          </p>

          <ul class="simple-list">

            <li>Stop worrying about harmless quality changes.</li>

            <li>Recognize genuine spoilage before opening a jar.</li>

            <li>Know exactly what to do when something doesn't look right.</li>

          </ul>

          <p>

            This guide gives you a clear decision-making framework based on
            tested home canning practices.

          </p>

        </div>

      </section>

      <!-- CONTENT -->

      <section class="section">

        <h2>Designed for Real Kitchen Questions</h2>

        <div class="steps book-categories">

          <div>

            <span>1</span>

            <h3>Check</h3>

            <p>
              Compare what you see with the illustrated examples.
            </p>

          </div>

          <div>

            <span>2</span>

            <h3>Understand</h3>

            <p>
              Learn whether the change is cosmetic, a quality issue, or a
              safety concern.
            </p>

          </div>

          <div>

            <span>3</span>

            <h3>Act</h3>

            <p>
              Follow the recommended action with confidence.
            </p>

          </div>

        </div>

      </section>

      <!-- FINAL CTA -->

      <section class="final-cta">

        <h2>Keep It Beside Your Canning Station</h2>

        <p>

          Print it once and you'll always have a trusted reference whenever a
          jar makes you pause.

        </p>

        <button class="openModal button" style="margin-top: 12px;">
          Download the Free Troubleshooting Guide
        </button>

        <p class="privacy">

          Free printable PDF for readers of
          <em>The Ultimate Water Bath Canning Cookbook for Beginners.</em>

        </p>

      </section>

    </section>
  </main>

<div
  id="modal"
  class="fixed inset-0 hidden items-center justify-center bg-black bg-opacity-40 backdrop-blur-sm z-50"
>
  <div class="m-2 bg-white p-6 rounded-2xl shadow-2xl max-w-md w-full">
    <div class="flex justify-between items-start">
      <h2 style="padding-top: 40px">
        Get Your Free Troubleshooting Guide
      </h2>

      <button
        id="closeModal"
        class="text-gray-500 hover:text-black"
        aria-label="Close modal"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    </div>

<div class="_form_13"></div><script src="https://gahema.activehosted.com/f/embed.php?id=13" charset="utf-8"></script>  </div>
</div>

<script>
  const modal = document.getElementById("modal");
  const openBtns = document.querySelectorAll(".openModal");
  const closeBtn = document.getElementById("closeModal");

  function openModal() {
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }

  function closeModal() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
  }

  openBtns.forEach((btn) => {
    btn.addEventListener("click", openModal);
  });

  closeBtn.addEventListener("click", closeModal);

  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });
</script>