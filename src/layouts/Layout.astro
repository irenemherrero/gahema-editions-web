---
const year = new Date().getFullYear();

const mainRoutes = [
  "/",
  "/canning-meat-cookbook",
  "/water-bath-canning-cookbook",
  "/amish-canning-meat-cookbook",
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const showHeader = mainRoutes.includes(currentPath);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      Gahema Press
    </title>
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script is:inline>
      (function(e,t,o,n,p,r,i){e.visitorGlobalObjectAlias=n;e[e.visitorGlobalObjectAlias]=e[e.visitorGlobalObjectAlias]||function(){(e[e.visitorGlobalObjectAlias].q=e[e.visitorGlobalObjectAlias].q||[]).push(arguments)};e[e.visitorGlobalObjectAlias].l=(new Date).getTime();r=t.createElement("script");r.src=o;r.async=true;i=t.getElementsByTagName("script")[0];i.parentNode.insertBefore(r,i)})(window,document,"https://diffuser-cdn.app-us1.com/diffuser/diffuser.js","vgo");
      vgo('setAccount', '255594189');
      vgo('setTrackByDefault', true);

      vgo('process');
      document.addEventListener("DOMContentLoaded", () => {
    const menuButton = document.querySelector(".menu-toggle");
    const mobileMenu = document.querySelector("#mobile-menu");

    if (!menuButton || !mobileMenu) return;

    menuButton.addEventListener("click", () => {
      const isOpen = mobileMenu.classList.toggle("is-open");

      menuButton.setAttribute("aria-expanded", String(isOpen));
      menuButton.setAttribute(
        "aria-label",
        isOpen ? "Close navigation menu" : "Open navigation menu"
      );
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.remove("is-open");
        menuButton.setAttribute("aria-expanded", "false");
        menuButton.setAttribute("aria-label", "Open navigation menu");
      });
    });
  });
  </script>
  </head>
  <body class="bg-gray-100 text-gray-900 min-h-screen">
  {
    showHeader && (
      <header class="site-header">
        <div class="site-header-container">
          
          

          <nav class="desktop-nav" aria-label="Main navigation">
            <a
              href="/"
              class:list={["nav-link", currentPath === "/" && "active"]}
            >
              Collection
            </a>

            <a
              href="/canning-meat-cookbook"
              class:list={[
                "nav-link",
                currentPath === "/canning-meat-cookbook" && "active",
              ]}
            >
              Canning Meat
            </a>

            <a
              href="/water-bath-canning-cookbook"
              class:list={[
                "nav-link",
                currentPath === "/water-bath-canning-cookbook" && "active",
              ]}
            >
              Water Bath
            </a>

            <a
              href="/amish-canning-meat-cookbook"
              class:list={[
                "nav-link",
                currentPath === "/amish-canning-meat-cookbook" && "active",
              ]}
            >
              Amish Canning
            </a>
          </nav>

          <button
            class="menu-toggle"
            type="button"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
          <div>
<a href="/" class="site-logo" aria-label="Gahema Press home">
          <img
            src="/public/logo_completo_negro.png"
            alt="Gahema Press"
            style="height: 40px;"
          />
          </a>
          </div>
        </div>

        <nav
          id="mobile-menu"
          class="mobile-nav"
          aria-label="Mobile navigation"
        >
          <a
            href="/"
            class:list={["mobile-nav-link", currentPath === "/" && "active"]}
          >
            Collection
          </a>

          <a
            href="/canning-meat-cookbook"
            class:list={[
              "mobile-nav-link",
              currentPath === "/canning-meat-cookbook" && "active",
            ]}
          >
            Canning Meat
          </a>

          <a
            href="/water-bath-canning-cookbook"
            class:list={[
              "mobile-nav-link",
              currentPath === "/water-bath-canning-cookbook" && "active",
            ]}
          >
            Water Bath
          </a>

          <a
            href="/amish-canning-meat-cookbook"
            class:list={[
              "mobile-nav-link",
              currentPath === "/amish-canning-meat-cookbook" && "active",
            ]}
          >
            Amish Canning
          </a>
        </nav>
      </header>
    )
  }

  <slot />

  <footer>
    <p>© {year} GAHEMA PRESS. All rights reserved.</p>
  </footer>

  {
    showHeader && (
      <script is:inline>
        {`
          const menuButton = document.querySelector(".menu-toggle");
          const mobileMenu = document.querySelector(".mobile-nav");

          if (menuButton && mobileMenu) {
            menuButton.addEventListener("click", () => {
              const isOpen = mobileMenu.classList.toggle("is-open");

              menuButton.setAttribute(
                "aria-expanded",
                isOpen ? "true" : "false"
              );

              menuButton.setAttribute(
                "aria-label",
                isOpen
                  ? "Close navigation menu"
                  : "Open navigation menu"
              );
            });

            mobileMenu.querySelectorAll("a").forEach((link) => {
              link.addEventListener("click", () => {
                mobileMenu.classList.remove("is-open");
                menuButton.setAttribute("aria-expanded", "false");
                menuButton.setAttribute(
                  "aria-label",
                  "Open navigation menu"
                );
              });
            });
          }
        `}
      </script>
    )
  }
</body>
</html>



<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    scroll-behavior: smooth;
    margin-top: 20px;
  }
   footer {
    background: var(--green-dark);
    color: white;
    text-align: center;
    padding: 20px;
    font-size: 0.9rem;
  }
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 1000;
  width: 100%;
  background: white;
}

.site-header-container {
  width: min(1180px, calc(100% - 40px));
  min-height: 76px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
}

.site-logo {
  flex: none;
  color: #263617;
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-decoration: none;
}

.desktop-nav {
  display: flex;
  align-items: center;
  gap: clamp(20px, 3vw, 38px);
}

.nav-link {
  position: relative;
  padding: 27px 0 24px;
  color: #4f5451;
  font-size: 1.2rem;
  font-weight: 500;
  text-decoration: none;
  transition: color 160ms ease;
}

.nav-link::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: 18px;
  left: 0;
  height: 2px;
  background: #e87525;
  transform: scaleX(0);
  transform-origin: center;
  transition: transform 160ms ease;
}

.nav-link:hover,
.nav-link.active {
  color: #263617;
}

.nav-link:hover::after,
.nav-link.active::after {
  transform: scaleX(1);
}

.menu-toggle {
  width: 46px;
  height: 46px;
  display: none;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 5px;
  padding: 0;
  background: transparent;
  cursor: pointer;
}

.menu-toggle span {
  width: 21px;
  height: 2px;
  display: block;
  background: #263617;
  transition:
    transform 180ms ease,
    opacity 180ms ease;
}

.menu-toggle[aria-expanded="true"] span:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.menu-toggle[aria-expanded="true"] span:nth-child(2) {
  opacity: 0;
}

.menu-toggle[aria-expanded="true"] span:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

.mobile-nav {
  display: none;
}

@media (max-width: 860px) {
  .site-header-container {
    min-height: 68px;
  }

  .desktop-nav {
    display: none;
  }

  .menu-toggle {
    display: flex;
  }

  .site-header-container {
    min-height: 68px;
  }

  .desktop-nav {
    display: none;
  }

  .menu-toggle {
    display: flex;
  }

  .mobile-nav {
    display: none;
    background: white;
    padding: 10px 20px 18px;
  }

  .mobile-nav.is-open {
    display: block;
  }

  .mobile-nav-link {
    display: block;
    width: min(1180px, 100%);
    margin: 0 auto;
    padding: 15px 4px;
    color: #4f5451;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
  }

  .mobile-nav-link:last-child {
    border-bottom: 0;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: #e87525;
  }
  
}

@media (max-width: 480px) {
  .site-header-container {
    width: min(100% - 28px, 1180px);
  }

  .site-logo {
    font-size: 0.88rem;
    letter-spacing: 0.13em;
  }
}
</style>
