---
import Layout from '../../layouts/Layout.astro';

import {amishReviewUrl} from '../../lib/constants';
---
<Layout>

<section class="redirect-page">
  <p>Redirecting you to the review page…</p>

  <p>
    <a href={amishReviewUrl}>Click here if nothing happens</a>
  </p>
</section>
</Layout> 

<script is:inline define:vars={{ amishReviewUrl }}>
  window.location.href = amishReviewUrl;
</script>