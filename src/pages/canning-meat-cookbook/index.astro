---
import Layout from '../../layouts/Layout.astro';
import { pressureCanningCover, pressureCanningAmazonUrl } from "../../lib/constants"

import "./styles.css";

---

<Layout>
  <main>
<section class="book-landing">
  <!-- HERO -->
  <section class="hero book-hero">
    <div class="hero__inner">
      <div class="hero__image">
        <img
          src={pressureCanningCover}
          alt="Canning Meat Cookbook for Beginners"
        />
      </div>

      <div class="hero__content">
        <p class="eyebrow">Beginner-friendly pressure canning</p>

        <h1>Learn to Pressure Can Meat Safely, Simply, and With Confidence</h1>

        <p class="subtitle">
          A practical guide for beginners who want shelf-stable meat, ready-to-eat meals,
          and a pantry they can actually rely on.
        </p>

        <ul class="benefits">
          <li>Step-by-step safety guidance</li>
          <li>50+ beginner-friendly meat recipes</li>
          <li>Pressure, time, and altitude tables included</li>
        </ul>

        <a href={pressureCanningAmazonUrl} class="button" target="_blank" rel="noopener noreferrer">
          Get the Book
        </a>

        <p class="privacy">
          Available in ebook, paperback, and hardcover.
        </p>
      </div>
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section class="trust">
    <h2>Built for beginners — not experts.</h2>
    <p>
      This book keeps the process clear, safe, and practical so you know what to do
      before, during, and after every batch.
    </p>
  </section>

  <!-- WHAT'S INSIDE -->
  <section class="section">
    <h2>What You’ll Learn Inside</h2>

    <div class="pack-card">
      <div class="pack-item">
        <span>✓</span>
        <div>
          <h3>The Foundation of Safe Meat Canning</h3>
          <p>
            Understand the equipment, ingredients, safety rules, and step-by-step
            process before your first batch.
          </p>
        </div>
      </div>

      <div class="pack-item">
        <span>✓</span>
        <div>
          <h3>Recipes from Everyday to Wild</h3>
          <p>
            Beef, pork, poultry, wild game, alternative proteins and
            ready-to-eat meals for a useful pantry.
          </p>
        </div>
      </div>

      <div class="pack-item">
        <span>✓</span>
        <div>
          <h3>Built to Use in the Kitchen</h3>
          <p>
            Every recipe includes difficulty rating, preparation time, cost per jar and shelf life. A Quick Recipe Index lets you find what you need by protein in seconds — no flipping through the whole book.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM SOLUTION -->
  <section class="problem-section">
    <div class="problem-card">
      <h2 style="padding-bottom: 18px">Because guessing is not a canning strategy</h2>

      <p>
        Meat canning <strong>can feel intimidating at first</strong> — especially when safety,
        pressure, and timing all matter.
      </p>

      <ul class="simple-list">
        <li>No more wondering which <strong>steps</strong> are critical.</li>
        <li>No more guessing about <strong>pressure and altitude</strong>.</li>
        <li><strong>No more feeling overwhelmed</strong> before your first batch.</li>
      </ul>

      <p>
        This book gives you a <strong>clear system</strong> to follow, so you can build your pantry
        one safe jar at a time.
      </p>
    </div>
  </section>

  <!-- RECIPE CATEGORIES -->
  <section class="section">
    <h2>Recipes Included</h2>

    <div class="steps book-categories">
      <div>
        <span>1</span>
        <h3>Beef</h3>
        <p>Everyday staples, stews, and versatile pantry jars.</p>
      </div>

      <div>
        <span>2</span>
        <h3>Pork</h3>
        <p>Flavorful, flexible recipes for weeknight meals.</p>
      </div>

      <div>
        <span>3</span>
        <h3>Poultry</h3>
        <p>Chicken and turkey options for easy meal prep.</p>
      </div>

      <div>
        <span>4</span>
        <h3>Wild Game</h3>
        <p>Venison and alternative proteins for a varied pantry.</p>
      </div>

      <div>
        <span>5</span>
        <h3>Ready-to-Eat Meals</h3>
        <p>Open the jar, heat, and serve.</p>
      </div>
    </div>
  </section>

  <!-- BONUSES -->
  <section class="section bonuses-section">
    <h2>Free Reader Bonuses</h2>

    <div class="pack-card">
      <div class="pack-item">
        <span>✓</span>
        <div>
          <h3>Canning Meat Checklist Pack</h3>
          <p>
            Two printable checklists to help you prepare your equipment and follow
            the canning process step by step.
          </p>
        </div>
      </div>

      <div class="pack-item">
        <span>✓</span>
        <div>
          <h3>Canning Meat Troubleshooting Guide</h3>
          <p>
            Practical safety checklists, warning signs, and troubleshooting references to help you understand what’s normal, what’s risky, and what to do next when something looks wrong in a jar.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta">
    <h2>Start Building a Pantry You Can Trust</h2>

    <p>
      Learn the process, follow safe steps, and create shelf-stable meat meals
      with confidence.
    </p>

    <a
      href={pressureCanningAmazonUrl}
      class="button"
      target="_blank"
      rel="noopener noreferrer"
      style="margin-top: 12px;"
    >
      Get the Book
    </a>

    <p class="privacy">
      Available on Amazon.
    </p>
  </section>
</section>
  </main>
</Layout>
