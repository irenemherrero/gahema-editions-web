---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="coming-soon">
    <div class="coming-soon-card">
      <span class="coming-soon-badge">COMING SOON</span>

      <h1>Coming soon.</h1>

      <p>
        This book is almost ready and will be available on Amazon very soon.
        We're putting the finishing touches on it.
      </p>

      <a href="/" class="coming-soon-button">
        Explore the collection
      </a>
    </div>
  </section>
</Layout>

<style>
  .coming-soon {
    min-height: calc(100vh - 76px);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 3rem 1.5rem;
    background: #f3f4f6;
  }

  .coming-soon-card {
    width: min(560px, 100%);
    padding: 4rem 3rem;
    text-align: center;

    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 24px;

    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.06);
  }

  .coming-soon-badge {
    display: inline-block;

    padding: 0.45rem 1rem;

    border-radius: 999px;

    background: rgba(232, 117, 37, 0.12);

    color: #e87525;

    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .coming-soon h1 {
    margin: 2rem 0 1.25rem;

    color: #243b18;

    font-size: clamp(3rem, 6vw, 4.4rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .coming-soon p {
    max-width: 420px;
    margin: 0 auto 2.5rem;

    color: #5d625f;

    font-size: 1.1rem;
    line-height: 1.7;
  }

  .coming-soon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 52px;

    padding: 0 1.8rem;

    border-radius: 999px;

    background: #243b18;

    color: white;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 600;

    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .coming-soon-button:hover {
    background: #e87525;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .coming-soon {
      min-height: calc(100vh - 68px);
      padding: 2rem 1rem;
    }

    .coming-soon-card {
      padding: 3rem 2rem;
      border-radius: 20px;
    }

    .coming-soon h1 {
      font-size: clamp(2.5rem, 12vw, 3.6rem);
    }

    .coming-soon p {
      font-size: 1rem;
    }

    .coming-soon-button {
      width: 100%;
    }
  }
</style>