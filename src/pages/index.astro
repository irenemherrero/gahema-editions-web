---
import Layout from "../layouts/Layout.astro";
import { amishCover, waterBathCover, pressureCanningCover } from "../lib/constants.js";
const books = [
  {
    title: "The Ultimate Canning Meat Cookbook for Beginners",
    category: "Pressure Canning",
    status: "Available Now",
    published: true,

    cover: pressureCanningCover,

    description:
      "Safe, beginner-friendly guidance and 52 USDA-based recipes for preserving beef, pork, poultry, wild game, and complete meals in jars.",

    pageUrl: "/canning-meat-cookbook",

    amazonUrl: "YOUR_AMAZON_LINK_HERE",

    accent: "terracotta",
  },

  {
    title: "The Ultimate Water Bath Canning Cookbook for Beginners",
    category: "Water Bath Canning",
    status: "Coming Soon",
    published: false,

    cover: waterBathCover,

    description:
      "Safe and approachable recipes for preserving fruits, tomatoes, pickles, jams, jellies, sauces, and homemade pantry staples.",

    pageUrl: "/water-bath-canning-cookbook",

    amazonUrl: "",

    accent: "plum",
  },
    {
    title: "The Ultimate Amish Canning Meat Cookbook for Beginners",
    category: "Amish-Inspired Pressure Canning",
    status: "Coming Soon",
    published: false,

    cover: amishCover,

    description:
      "Thirty Amish-inspired meat recipes adapted for safe pressure canning, with practical guidance for building a simple and dependable pantry.",

    pageUrl: "/amish-canning-meat-cookbook",

    amazonUrl: "",

    accent: "green",
  },
     
];
---

<Layout
  title="Gahema Press | Practical Canning Books for Beginners"
  description="Explore the Gahema Press collection of beginner-friendly pressure canning and water bath canning books."
>
  <main class="catalog-page">

    <!-- =====================================================
         HERO EDITORIAL
    ====================================================== -->

    <section class="hero">
      <div aria-hidden="true"></div>
      <div class="hero-circle hero-circle-left" aria-hidden="true"></div>
      <div class="hero-circle hero-circle-right" aria-hidden="true"></div>

      <div class="hero-container">
        <div class="hero-copy">
          <p class="eyebrow">
            The Gahema Press Canning Collection
          </p>

          <h1>
            Preserve with knowledge.
            <span style="text-decoration: underline; text-decoration-color: #E87425">Build your pantry with confidence.</span>
          </h1>

          <p class="hero-description">
            Clear, practical canning books created for beginners who want
            reliable guidance, approachable recipes, and a pantry they can
            depend on throughout the year.
          </p>

          <a href="#collection" class="button button-primary">
            Explore the Collection
          </a>
        </div>

        <div
          class="hero-books"
          aria-label="Books in the Gahema Press canning collection"
        >
          <a
          href={books[1].pageUrl}
            class="hero-book hero-book-left"
            aria-label={`Discover ${books[1].title}`}
          >
            <img
              src={books[1].cover}
              alt={`Cover of ${books[1].title}`}
              width="600"
              height="900"
            />
          </a>

          <a
            href={books[0].pageUrl}
            class="hero-book hero-book-center"
            aria-label={`Discover ${books[0].title}`}
          >
            <img
              src={books[0].cover}
              alt={`Cover of ${books[0].title}`}
              width="600"
              height="900"
            />
          </a>

          <a
          href={books[2].pageUrl}
            class="hero-book hero-book-right"
            aria-label={`Discover ${books[2].title}`}
          >
            <img
              src={books[2].cover}
              alt={`Cover of ${books[2].title}`}
              width="600"
              height="900"
            />
          </a>
        </div>
      </div>
    </section>

    <!-- =====================================================
         PRINCIPIOS DE LA COLECCIÓN
    ====================================================== -->

    <section
      class="principles"
      aria-label="The principles behind the Gahema Press collection"
    >
      <article class="principle">
        <span class="principle-number">01</span>

        <div>
          <h2 style="font-size: 1.5rem;">Beginner Friendly</h2>

          <p style="font-size: 1.2rem;">
            Clear explanations without unnecessary complexity.
          </p>
        </div>
      </article>

      <article class="principle">
        <span class="principle-number">02</span>

        <div>
          <h2 style="font-size: 1.5rem;">Safety Focused</h2>

          <p style="font-size: 1.2rem;">
            Methods grounded in trusted home-canning guidance.
          </p>
        </div>
      </article>

      <article class="principle">
        <span class="principle-number">03</span>

        <div>
          <h2 style="font-size: 1.5rem;">Made for Real Life</h2>

          <p style="font-size: 1.2rem;">
            Practical recipes for useful and dependable pantry staples.
          </p>
        </div>
      </article>
    </section>

    <!-- =====================================================
         CATÁLOGO
    ====================================================== -->

    <section class="collection-section" id="collection">
      <div class="section-heading">
        <p class="eyebrow">The Collection</p>

        <h2>
          Three practical guides for confident home preservation
        </h2>

        <p style="font-size: 1.2rem;">
          Start with pressure-canned meat, discover Amish-inspired farm
          cooking, or preserve the best of the seasonal harvest with water
          bath canning.
        </p>
      </div>

      <div class="book-grid">
        {
          books.map((book) => (
            <article class={`book-card book-card-${book.accent}`}>
              <div class="book-cover-area">
                <span
                  class:list={[
                    "status-badge",
                    book.published
                      ? "status-available"
                      : "status-coming",
                  ]}
                >
                  {book.status}
                </span>

                <a
                  href={book.pageUrl}
                  class="book-cover-link"
                  aria-label={`Discover ${book.title}`}
                >
                  <img
                    src={book.cover}
                    alt={`Cover of ${book.title}`}
                    class="book-cover"
                    loading="lazy"
                    width="600"
                    height="900"
                  />
                </a>
              </div>

              <div class="book-content">
                <p class="book-category">
                  {book.category}
                </p>

                <h3>
                  <a href={book.pageUrl}>
                    {book.title}
                  </a>
                </h3>

                <p class="book-description">
                  {book.description}
                </p>

                <div class="book-actions">
                  <a
                    href={book.pageUrl}
                    class="button button-outline"
                  >
                    Discover the Book
                  </a>

                  
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- =====================================================
         ENCUENTRA TU LIBRO
    ====================================================== -->

    <section class="find-book-section">
      <div class="find-book-heading">
        <p class="eyebrow">Where Should You Begin?</p>

        <h2>
          Choose the guide that fits your pantry
        </h2>
      </div>

      <div class="find-book-grid">
        <article class="find-book-card">
          <span class="find-book-label">For a dependable meat pantry</span>

          <h3>Pressure Canning Meat</h3>

          <p style="font-size: 1rem;">
            Build a pantry of beef, pork, poultry, wild game and
            complete meals that can be opened, heated, and served when you
            need them.
          </p>

          <a style="font-size: 1rem;" href={books[0].pageUrl}>
            Explore the Meat Cookbook
            <span aria-hidden="true">→</span>
          </a>
        </article>

        <article class="find-book-card">
          <span class="find-book-label">For seasonal produce</span>

          <h3>Water Bath Canning</h3>

          <p style="font-size: 1rem;">
            Preserve fruits, tomatoes, pickles, jams, jellies, sauces, and
            other homemade staples to enjoy throughout the year.
          </p>

          <a style="font-size: 1rem;" href={books[1].pageUrl}>
            Explore the Water Bath Cookbook
            <span aria-hidden="true">→</span>
          </a>
        </article>
        <article class="find-book-card">
          <span class="find-book-label">For rustic farm cooking</span>

          <h3>Amish-Inspired Canning</h3>

          <p style="font-size: 1rem;">
            Discover simple, resourceful farm-kitchen flavors adapted for
            safe pressure canning and practical modern pantry use.
          </p>

          <a style="font-size: 1rem;" href={books[2].pageUrl}>
            Explore the Amish Cookbook
            <span aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </section>

    <!-- =====================================================
         FILOSOFÍA EDITORIAL
    ====================================================== -->

    <section class="approach-section">
      <div class="approach-container">
        <div class="approach-heading">
          <p class="eyebrow eyebrow-light">
            The Gahema Press Approach
          </p>

          <h2>
            Books that teach more than recipes
          </h2>
        </div>

        <div class="approach-copy">
          <p class="approach-lead">
            Home canning can feel intimidating when instructions are vague,
            contradictory, or written for experienced preservers.
          </p>

          <p style="font-size: 1.2rem;">
            Gahema Press books are designed to make the process easier to
            understand. Each title combines practical explanations,
            structured recipes, useful reference information, and
            step-by-step guidance for readers who want to preserve food
            safely and confidently.
          </p>

          <p style="font-size: 1.2rem;">
            The goal is simple: to help you understand what you are doing,
            why each step matters, and how to build a pantry that genuinely
            supports everyday life.
          </p>
        </div>
      </div>
    </section>

    <!-- =====================================================
         CIERRE
    ====================================================== -->

    <section class="closing-section">
      <div
        class="closing-circle closing-circle-left"
        aria-hidden="true"
      ></div>

      <div
        class="closing-circle closing-circle-right"
        aria-hidden="true"
      ></div>

      <div class="closing-content">
        <p class="eyebrow">
          One Collection. Three Ways to Preserve.
        </p>

        <h2>
          Start with the method that fits your kitchen and your pantry.
        </h2>

        <p style="font-size: 1.2rem;">
          Whether you are preserving meat, traditional farm-style meals, or
          the best of the seasonal harvest, there is a Gahema Press guide
          created to help you begin.
        </p>

        <a href="#collection" class="button button-primary">
          Find Your Book
        </a>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  html,
  body {
    background: #f3f4f6 !important;
    color: #263617;
    font-family: "Barlow", Arial, sans-serif !important;
  }

  body.bg-gray-100 {
    background-color: #f3f4f6 !important;
  }

  .catalog-page,
  .catalog-page button,
  .catalog-page input,
  .catalog-page textarea,
  .catalog-page select {
    font-family: "Barlow", Arial, sans-serif !important;
  }

  .catalog-page h1,
  .catalog-page h2,
  .catalog-page h3,
  .catalog-page h4,
  .catalog-page h5,
  .catalog-page h6,
  .catalog-page p,
  .catalog-page a,
  .catalog-page span {
    font-family: inherit !important;
  }

  :root {
    --page-bg: #f3f4f6;
    --section-bg: #ffffff;
    --soft-green: #eef6ee;
    --ink: #263617;
    --muted: #575b5f;
    --border: #d9ded7;

    --terracotta: #e87525;
    --terracotta-dark: #c85f18;

    --green: #536347;
    --green-dark: #263617;

    --plum: #695064;
    --plum-dark: #4e394a;

    --gold: #e87525;

    --catalog-shadow:
      0 18px 50px rgba(38, 54, 23, 0.12);
  }

  body {
    background: var(--page-bg);
    color: var(--ink);
  }
</style>

<style>
  .catalog-page {
    overflow: hidden;
    background: var(--page-bg);
    color: var(--ink);
    font-family: "Barlow", sans-serif;
    line-height: 1.7;
  }

  .catalog-page *,
  .catalog-page *::before,
  .catalog-page *::after {
    box-sizing: border-box;
  }

  .catalog-page img {
    display: block;
    max-width: 100%;
  }

  .catalog-page a {
    color: inherit;
  }

  /* =====================================================
     ELEMENTOS COMPARTIDOS
  ====================================================== */

  .eyebrow {
    margin: 0 0 21px;
    color: var(--terracotta);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .button {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 27px;
    border: 1px solid transparent;

    font-size: 0.77rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;

    transition:
      transform 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .button-primary {
    font-size: 1.2rem;
    background: var(--terracotta);
    color: white !important;
  }

  .button-primary:hover {
    background: var(--terracotta-dark);
    transform: translateY(-2px);
  }

  .button-outline {
    border-color: var(--ink);
    background: transparent;
    color: var(--ink);
    font-size: 1rem;
  }

  .button-outline:hover {
    background: var(--ink);
    color: white !important;
    transform: translateY(-2px);
  }


  /* =====================================================
     HERO
  ====================================================== */

  .hero {
    min-height: 880px;
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: 85px 40px 140px;

    background: var(--page-bg);
  }

  .hero-frame {
    position: absolute;
    inset: 40px;
    border: 1px solid rgba(38, 54, 23, 0.16);
    pointer-events: none;
  }

  .hero-container {
    width: min(1180px, 100%);
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(520px, 1.1fr);
    gap: clamp(50px, 7vw, 100px);
    align-items: center;
  }

  .hero-copy {
    max-width: 590px;
  }

  .brand {
    width: fit-content;
    margin-bottom: 72px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-decoration: none;
  }

  .brand-name {
    font-family: "Barlow", sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .brand-line {
    width: 48px;
    height: 1px;
    margin: 13px 0 10px;
    background: var(--gold);
  }

  .brand-tagline {
    color: var(--muted);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero h1 {
    margin: 0;
    font-family: "Barlow", sans-serif;
    font-size: clamp(2.8rem, 5vw, 4.9rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.13;
  }

  .hero h1 span {
    display: block;
    margin-top: 12px;
    color: var(--green-dark);
  }

  .hero-description {
    max-width: 575px;
    margin: 30px 0 38px;
    color: var(--muted);
    font-size: 1.3rem;
    line-height: 1.8;
  }

  .hero-books {
    min-height: 580px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-book {
    width: 230px;
    position: absolute;
    display: block;
    text-decoration: none;
    transition:
      transform 230ms ease,
      z-index 230ms ease;
  }

  .hero-book img {
    width: 100%;
    height: auto;
    border: 1px solid rgba(41, 40, 32, 0.15);
    box-shadow: 0 28px 50px rgba(38, 32, 23, 0.3);
  }

  .hero-book-center {
    z-index: 3;
    width: 265px;
    transform: translateY(-12px);
  }

  .hero-book-left {
    z-index: 1;
    left: 2%;
    transform: translateY(30px) rotate(-5deg);
  }

  .hero-book-right {
    z-index: 2;
    right: 2%;
    transform: translateY(30px) rotate(5deg);
  }

  .hero-book-center:hover {
    transform: translateY(-22px) scale(1.025);
  }

  .hero-book-left:hover {
    z-index: 5;
    transform:
      translateY(15px)
      translateX(10px)
      rotate(-2deg)
      scale(1.025);
  }

  .hero-book-right:hover {
    z-index: 5;
    transform:
      translateY(15px)
      translateX(-10px)
      rotate(2deg)
      scale(1.025);
  }

  .hero-book-status {
    position: absolute;
    right: 50%;
    bottom: -18px;
    transform: translateX(50%);
    white-space: nowrap;

    padding: 9px 13px;
    background: var(--green);
    color: white;

    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;

    box-shadow: 0 7px 18px rgba(31, 27, 21, 0.18);
  }

  .hero-book-status-available {
    background: var(--terracotta);
  }

  .hero-circle,
  .closing-circle {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-circle {
    width: 330px;
    height: 330px;
    border: 1px solid rgba(38, 54, 23, 0.11);
  }

  .hero-circle-left {
    bottom: -185px;
    left: -85px;
  }

  .hero-circle-right {
    top: -190px;
    right: -75px;
  }

  /* =====================================================
     PRINCIPIOS
  ====================================================== */

  .principles {
    width: min(1180px, calc(100% - 40px));
    position: relative;
    z-index: 5;
    margin: -58px auto 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-bottom: 5rem;
    background: var(--section-bg);
    border: 1px solid var(--border);
    box-shadow: var(--catalog-shadow);
  }

  .principle {
    min-width: 0;
    display: flex;
    gap: 18px;
    padding: 32px 29px;
  }

  .principle + .principle {
    border-left: 1px solid var(--border);
  }

  .principle-number {
    flex: none;
    color: var(--gold);
    font-family: "Barlow", sans-serif;
    font-size: 1.16rem;
    font-weight: 700;
  }

  .principle h2 {
    margin: 0 0 7px;
    font-family: "Barlow", sans-serif;
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .principle p {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  /* =====================================================
     CATÁLOGO
  ====================================================== */

  .collection-section {
    padding: 145px 24px 150px;
    background: white;
  }

  .section-heading {
    width: min(780px, 100%);
    margin: 0 auto 70px;
    text-align: center;
  }

  .section-heading h2,
  .approach-heading h2,
  .closing-content h2,
  .find-book-heading h2 {
    margin: 0;
    font-family: "Barlow", sans-serif;
    font-size: clamp(2.15rem, 4.4vw, 3.45rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .section-heading > p:last-child {
    max-width: 660px;
    margin: 23px auto 0;
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.8;
  }

  .book-grid {
    width: min(1180px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    align-items: stretch;
  }

  .book-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--section-bg);
    border: 1px solid var(--border);
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .book-card:hover {
    transform: translateY(-7px);
    box-shadow: var(--catalog-shadow);
  }

  .book-cover-area {
    min-height: 450px;
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .book-card-terracotta .book-cover-area {
    background: #f6e4d8;
  }

  .book-card-green .book-cover-area {
    background: #e7eee3;
  }

  .book-card-plum .book-cover-area {
    background: #fcf4d5;
  }

  .status-badge {
    position: absolute;
    top: 28px;
    left: 28px;
    z-index: 4;
    padding: 9px 13px;

    color: white;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .status-available {
    background: var(--terracotta);
  }

  .status-coming {
    background: var(--green);
  }
  .book-cover-link {
    width: min(250px, 79%);
    position: relative;
    z-index: 2;
    text-decoration: none;
  }

  .book-cover {
    width: 100%;
    height: auto;
    box-shadow: 0 22px 36px rgba(31, 27, 21, 0.28);
    transition: transform 220ms ease;
  }

  .book-cover-link:hover .book-cover {
    transform: scale(1.025);
  }
  .status-available {
    background: var(--terracotta);
  }

  .status-coming {
    background: var(--green);
  }

  .book-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 35px 31px 32px;
  }

  .book-category {
    margin: 0 0 13px;
    color: var(--terracotta);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .book-card-green .book-category {
    color: var(--green);
  }

  .book-card-plum .book-category {
    color: var(--plum);
  }

  .book-content h3 {
    margin: 0;
    font-family: "Barlow", sans-serif;
    font-size: 1.4rem;
    line-height: 1.38;
  }

  .book-content h3 a {
    text-decoration: none;
  }

  .book-content h3 a:hover {
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .book-description {
    margin: 20px 0 20px;
    color: var(--muted);
    font-size: 1.2rem;
    line-height: 1.75;
  }

  .book-actions {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 17px;
  }


  /* =====================================================
     ENCUENTRA TU LIBRO
  ====================================================== */

  .find-book-section {
    padding: 125px 24px 135px;
    background: var(--page-bg);
  }

  .find-book-heading {
    width: min(740px, 100%);
    margin: 0 auto 62px;
    text-align: center;
  }

  .find-book-grid {
    width: min(1120px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
  }

  .find-book-card {
    padding: 39px 34px 36px;
    background: var(--section-bg);
    border: 1px solid var(--border);
        display: flex;
