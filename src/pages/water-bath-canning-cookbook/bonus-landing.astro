---
import LeadMagnetQR1 from '../../components/lead-magnet-sections/water-bath-canning-cookbook/LeadMagnetsLandings/LeadMagnetQR1/LeadMagnetQR1.astro';
import LeadMagnetQR2 from '../../components/lead-magnet-sections/water-bath-canning-cookbook/LeadMagnetsLandings/LeadMagnetQR2/LeadMagnetQR2.astro';

import Layout from '../../layouts/Layout.astro';

const { searchParams } = Astro.url;
const leadMagnetId = searchParams.get('origin') || 'qr1';

---

<Layout>
  <main>
    {leadMagnetId === "qr1" && <LeadMagnetQR1 />}
    {leadMagnetId === "qr2" && <LeadMagnetQR2 />}
  </main>
</Layout>
